{
  "name": "attune",
  "private": true,
  "version": "0.0.0",
  "description": "A web music player in tune with your life.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "icons": "pwa-assets-generator"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.9",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.19.2",
    "@types/wicg-file-system-access": "^2023.10.7",
    "@vite-pwa/assets-generator": "^2.0.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.2",
    "workbox-window": "^7.4.1"
  },
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/syne": "^5.3.0",
    "idb": "^8.0.4",
    "music-metadata": "^13.0.0"
  }
}
